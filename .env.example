# Copia este archivo como .env y rellénalo. El .env no se sube a GitHub.
# Palabra de paso de la mesa: hace falta para CREAR una cuenta. Vacía = cualquiera puede crearse una.
# Quien no la tenga puede crear la cuenta con Discord (queda pendiente hasta que un DM la apruebe).
ALQUIMIA_CLAVE=
# Contraseña fija del superusuario «DM» (el administrador). Mínimo 6 caracteres. Vacía = no hay superusuario.
ALQUIMIA_ADMIN=

# --- Discord (opcional): crear cuenta sin palabra de paso y vincular. Vacías = sin Discord. Pasos en docs/DISCORD.md.
# Client ID y Client Secret de tu aplicación en https://discord.com/developers/applications (pestaña OAuth2).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Dirección pública de la app, sin barra al final. Discord vuelve a ALQUIMIA_URL/api/discord/vuelta. Ejemplo: https://TU-MAQUINA.TU-RED.ts.net
ALQUIMIA_URL=

# --- Correo (opcional): para que quien olvide la contraseña pueda cambiarla con un enlace. Vacías = sin correo.
# Pasos en docs/CORREO.md. Con Gmail: tu dirección y una «contraseña de aplicación» (NO tu contraseña normal).
# Los enlaces apuntan a ALQUIMIA_URL, así que conviene tenerla puesta.
CORREO_USUARIO=
CORREO_CLAVE=
# Solo si no usas Gmail (por defecto smtp.gmail.com y puerto 587) o quieres otro remitente:
CORREO_SERVIDOR=
CORREO_PUERTO=
CORREO_REMITENTE=
